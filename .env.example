# Copy this file to `.env` and fill in real values.
#     cp .env.example .env
#
# `.env` is gitignored and must never be committed. Real environment variables
# take precedence over values in `.env`.

# ---------------------------------------------------------------------------
# Admin portal credentials (REQUIRED — the server refuses to start without them)
# ---------------------------------------------------------------------------
# Username for /admin.html. Any value you like.
ADMIN_USER=admin

# Password for /admin.html. Must be at least 10 characters.
# On first run this seeds content/admin-auth.json as a salted PBKDF2 hash;
# the plaintext is never written to disk and never sent to the browser.
# Change it later from the admin portal's change-password form.
# There is intentionally NO default password.
ADMIN_PASS=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Public origin, used for RSS <link> and <guid> values in feed.xml.
# Replace the placeholder with your real deployment origin before launch.
SITE_URL=https://saptarushi.example

# Dev server port. A CLI arg takes precedence: `node serve.js 8080`.
PORT=4173